# GitHub Configuration for Gist Storage
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# Application Settings
APP_NAME=IP-Tracker
APP_VERSION=2.0
APP_DESCRIPTION=Advanced IP tracking with fingerprinting

# Data Storage Options
STORAGE_TYPE=localStorage  # Options: localStorage, github_gist
DATA_RETENTION_DAYS=30

# Security Settings
ENCRYPT_DATA=false
CORS_ORIGINS=*

# API Endpoints (for future use)
GEOIP_API_URL=http://ip-api.com/json/
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Admin Panel Settings
ADMIN_PASSWORD=changeme123
AUTO_REFRESH_INTERVAL=30000

# Logging
LOG_LEVEL=info
LOG_TO_CONSOLE=true
LOG_TO_FILE=false

# Feature Flags
ENABLE_WEBRTC=true
ENABLE_GEOLOCATION=true
ENABLE_FINGERPRINTJS=true
ENABLE_WEBGL=true
ENABLE_AUDIO=true
ENABLE_BATTERY=true
ENABLE_CONNECTION=true
